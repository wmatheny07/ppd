FROM apache/superset:latest

# Install the Postgres driver into the Superset venv
USER root
# Explicitly install all three Chromium packages so apt tracks them as manual
# installs and upgrades them on every --no-cache rebuild (fixes CVE-2026-7347,
# requires chromium >= 147.0.7727.137-1~deb12u1).
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium chromium-common chromium-driver \
    && rm -rf /var/lib/apt/lists/*

RUN /app/.venv/bin/python -m ensurepip --upgrade && \
    /app/.venv/bin/python -m pip install --no-cache-dir psycopg2-binary && \
    chown -R superset:superset /app/.venv

USER superset
WORKDIR /app
